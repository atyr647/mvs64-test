+// --- miss profiler (local patch): which code/data causes cache misses ---
+#include <unordered_map>
+#include <vector>
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+struct MissProf {
+  bool on = false;
+  std::unordered_map<u32,u32> icLine, dcPc, dcAddr;
+  std::unordered_map<u64,u32> dcPair;
+  void reset() { icLine.clear(); dcPc.clear(); dcAddr.clear(); dcPair.clear(); on = true; }
+  // MISSPROF_START / MISSPROF_END (CPU clocks): profile a fixed window without ROM support
+  s64 winStart = -1, winEnd = -1; bool winDone = false;
+  void tick(s64 clk) {
+    if (winStart < 0) { const char* a = getenv("MISSPROF_START"); const char* b = getenv("MISSPROF_END");
+      winStart = a ? atoll(a) : 0x7fffffffffffffffLL; winEnd = b ? atoll(b) : 0x7fffffffffffffffLL; }
+    if (!winDone && !on && clk >= winStart && clk < winEnd) reset();
+    if (on && clk >= winEnd && !winDone) { winDone = true; dump(); }
+  }
+  void dump() {
+    on = false;
+    const char* path = getenv("MISSPROF_OUT"); if(!path) path = "missprof.txt";
+    FILE* f = fopen(path, "w"); if(!f) return;
+    auto out = [&](const char* tag, std::unordered_map<u32,u32>& m) {
+      std::vector<std::pair<u32,u32>> v(m.begin(), m.end());
+      std::sort(v.begin(), v.end(), [](auto& a, auto& b){ return a.second > b.second; });
+      for(auto& e : v) fprintf(f, "%s %08x %u\n", tag, e.first, e.second);
+    };
+    out("IC", icLine); out("DPC", dcPc); out("DAD", dcAddr);
+    { std::vector<std::pair<u64,u32>> v(dcPair.begin(), dcPair.end());
+      std::sort(v.begin(), v.end(), [](auto& a, auto& b){ return a.second > b.second; });
+      for(auto& e : v) fprintf(f, "DPR %08x %08x %u\n", (u32)(e.first >> 32), (u32)e.first, e.second); }
+    fclose(f);
+  }
+};
+inline MissProf missProf;
+
 struct CPU : Thread {
   Node::Object node;
 
