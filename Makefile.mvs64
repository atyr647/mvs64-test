ifndef BIOS
$(error NeoGeo BIOS not specified: use make mvs64 BIOS=<bios.bin>)
endif
ifndef ROM
$(error NeoGeo game ROM not specified: use make mvs64 ROM=<rom.zip>)
endif

BUILD_DIR = build/mvs64

include $(N64_INST)/include/n64.mk

# Link with a copy of libdragon's n64.ld that places the 68K interpreter's hot
# code first and contiguous, sorted by section name (.text.m68k.NNNN, hottest
# first: see m68kops_layout.h).  The VR4300 I-cache is 16 KB direct-mapped, so
# code within one contiguous 16 KB never evicts itself.
N64_LDFLAGS := $(subst -Tn64.ld,-Tmvs64.ld,$(N64_LDFLAGS))
.DEFAULT_GOAL := all
# Cache-coloured code/data placement (tools/layout/README.md): by default the
# layout trained for this ROM, tools/layout/<rom>.ld, if there is one; it moves
# FPS by +10-13% for Blazing Star. CACHE_LAYOUT= (empty) turns it off.
CACHE_LAYOUT ?= $(wildcard tools/layout/$(notdir $(basename $(ROM))).ld)
ifneq ($(CACHE_LAYOUT),)
LTO_SECTIONS ?= 1
endif
# CACHE_LAYOUT=<file>: merge a cache-coloured placement (tools/layout,
# generated by realize2.py from cache traces) into the script; build with
# LTO_SECTIONS=1 so the sections it names exist.
mvs64.ld: $(N64_LIBDIR)/n64.ld Makefile.mvs64 $(CACHE_LAYOUT)
	sed 's/^\( *\)\*(\.boot)$$/\1*(.boot)\n\1. = ALIGN(32);\n\1__m68k_hot_start = .;\n\1*(SORT(.text.m68k.*))\n\1__m68k_hot_end = .;/' $< > $@
	$(if $(CACHE_LAYOUT),python3 tools/layout/apply_layout.py $@ $(CACHE_LAYOUT) $@)
# M68K_HOT_LIST=/dev/null gives the unordered layout, for A/B measurements
M68K_HOT_LIST ?= m68kops_hot.txt
m68kops_layout.h: $(M68K_HOT_LIST) tools/prof/mklayout.py
	python3 tools/prof/mklayout.py $< $@
$(BUILD_DIR)/m68kops.o: m68kops_layout.h

# 68K CPU core selection: USE_FAME=1 for FAME, otherwise Musashi
ifdef USE_FAME
src_68k = cpu/fame/famec.c fame_adapter.c
CFLAGS += -DUSE_FAME -I.
# FAME is enormous; needs reduced optimization to avoid GCC memory issues
$(BUILD_DIR)/cpu/fame/famec.o: CFLAGS += -g0 -O2 -fno-expensive-optimizations
else
src_68k = m68kcpu.c m68kops.c
# Musashi's generated opcode file is huge; keep at -O2
M68KOPS_OPT ?= -O2
$(BUILD_DIR)/m68kops.o: CFLAGS += $(M68KOPS_OPT)
endif

# AOT recompilation ("HLE") for hot 68K functions.  When USE_HLE=1 the build
# invokes ./genhle against the byteswapped P-ROM + BIOS to emit one hle_<pc>.c
# per listed entry address plus a perfect-hash lookup table (hle_index.[ch]).
# m68k_execute() then checks hle_get_func(REG_PC) before falling through to
# the interpreter dispatch.
#
# PCs are picked per game with tools/prof (exact per-PC instruction counts).
# Re-profile when the game or the scene mix changes.
#
# The game's wait-for-vblank loop (0x3b5c) is not in the list: it is handled
# by idle_skip (game.ini, see mvsmakerom.c), which ends the timeslice at once.
ifdef USE_HLE
# Each generated hle_*.c adds code to RDRAM, and the PBROM allocation needs a
# 1 MiB-aligned contiguous region: check the boot log after growing the list.
# Keep unrolled straight-line routines out (the April 2026 list 5152 522e 5382
# 53d2 5866 5cba 5b50 5a26): native code that runs once per call flushes the
# 16 KB I-cache and measured slower than interpreting it.
#
# Blazing Star, Stage 1 (Nov 2026): half of the non-idle 68K time is in the
# object loop and sprite-list builder at 4012/41b8.
#   object loop + sprite list builder : 4012 4096 41b8
#   collision detection               : 4f920
#   task scheduler / yield            : 3820 3878 (re-entered at 3860)
#   misc scans and text output        : 4f0c6 11e6 1160
# tools/prof/autopick.py proposes a longer list from a profile; a 46-entry
# list from it measured slower (I-cache) and changed the game state, so new
# entries must be verified one by one with -DPROFILER_STATE.
HLE_PCS = 4012 4096 41b8 4f920 3820 3878 4f0c6 11e6 1160
# Extra entrypoints inside the functions above (see genhle.c, "@pc")
HLE_ENTRIES = 3860
# Unrolled runs (see genhle.c, "rPC"): the two VRAM upload tables, entered at a
# computed offset, about 1200 instructions per frame in Stage 1.
HLE_RUNS = 445c 5ae8
HLE_GEN_C = $(patsubst %,hle_%.c,$(HLE_PCS) $(HLE_RUNS)) hle_index.c
HLE_GEN_H = hle_index.h
HLE_ALL   = $(HLE_GEN_C) $(HLE_GEN_H)
CFLAGS += -DUSE_HLE
else
HLE_GEN_C = $(wildcard hle_*.c)
HLE_GEN_H =
HLE_ALL   =
endif

# 68K dynamic recompiler (JIT).  USE_DRC=1 compiles 68K basic blocks to
# native MIPS III at runtime.  Falls back to the interpreter for unsupported
# opcodes.  Can coexist with USE_HLE (HLE gets priority for its static PCs,
# DRC covers everything else).
ifdef USE_DRC
src_drc = cpu/drc/drc68k.c
CFLAGS += -DUSE_DRC
$(shell mkdir -p $(BUILD_DIR)/cpu/drc)
$(info [DRC] USE_DRC is set, adding cpu/drc/drc68k.c)
else
src_drc =
endif

# Sound subsystem: Z80 (CZ80) + YM2610 + RSP FM synthesis
src_sound = sound/ym2610_intf.c sound/rsp_fm.c sound/rsp_audio.c
$(shell mkdir -p $(BUILD_DIR)/sound $(BUILD_DIR)/cpu/cz80)
# CZ80 is compiled separately without LTO (large generated code)
$(BUILD_DIR)/cpu/cz80/cz80.o: CFLAGS += -O2 -fno-lto
# Sound subsystem compiled without LTO — RSP ucode symbols and cross-object
# calls between LTO and non-LTO objects don't resolve cleanly.
$(BUILD_DIR)/sound/rsp_fm.o: CFLAGS += -fno-lto
$(BUILD_DIR)/sound/rsp_audio.o: CFLAGS += -fno-lto
$(BUILD_DIR)/sound/ym2610_intf.o: CFLAGS += -fno-lto $(SND_OPT)
CFLAGS += -Icpu/cz80 -Ipico $(SND_CFLAGS)

src = emu.c roms.c hw.c video.c platform_n64.c sprite_cache.c lib/rdl.c tlb_handler.c $(src_68k) $(HLE_GEN_C) $(src_drc) $(src_sound) cpu/cz80/cz80.c
asm = tlb_vector.S
rsp = rsp_video.S rsp_fm.S
obj = $(src:%.c=$(BUILD_DIR)/%.o) $(asm:%.S=$(BUILD_DIR)/%.o) $(rsp:%.S=$(BUILD_DIR)/%.o)

src_makerom = mvsmakerom.c miniz.c
obj_makerom = $(src_makerom:%.c=$(BUILD_DIR)/%.o)

CFLAGS += -Wno-unused-function -O3 -flto -fomit-frame-pointer -finline-limit=300 -funroll-loops -DUSE_TLB_FETCH
LDFLAGS += -flto

ROMNAME=$(notdir $(basename $(ROM)))
ROMDIR=$(ROM:%.zip=%.n64)

all: mvsmakerom mvs64-${ROMNAME}.z64

test:
	make -f Makefile.tests all

# Byteswapping the BIOS+ROM into $(ROMDIR) is split from DFS packaging so
# that the HLE code generator can depend on its output (p.rom, p.bios, ...)
# without re-running mvsmakerom on every HLE re-gen.  A sentinel file tracks
# "mvsmakerom ran successfully for this (BIOS, ROM) pair."
MVS_STAMP = $(BUILD_DIR)/.mvs-stamp

$(MVS_STAMP): $(ROM) mvsmakerom
	@echo "    [MVS] ${ROMDIR}"
	./mvsmakerom $(BIOS) $(ROM)
	@mkdir -p $(dir $@)
	@touch $@

$(BUILD_DIR)/mvs64-${ROMNAME}.dfs: $(MVS_STAMP)
	@echo "    [DFS] $@"
	$(N64_MKDFS) $@ $(ROMDIR) >/dev/null

mvs64-${ROMNAME}.z64: $(BUILD_DIR)/mvs64-${ROMNAME}.dfs
mvs64-${ROMNAME}.z64: N64_ROM_TITLE="MVS64: ${ROMNAME}"
$(BUILD_DIR)/mvs64-${ROMNAME}.elf: $(obj) mvs64.ld
# LTO_SECTIONS=1: one section per function and data object in the final LTO
# code generation too (it runs at link time, and n64.mk's link line passes no
# compiler flags), so a cache-coloured layout can place each one.
ifdef LTO_SECTIONS
CFLAGS += -ffunction-sections -fdata-sections
$(BUILD_DIR)/mvs64-${ROMNAME}.elf: CXX = $(N64_CXX) -ffunction-sections -fdata-sections
endif

mvsmakerom: $(obj_makerom)
	@echo "    [LD] $@"
	$(CC) $(LDFLAGS) -o $@ $^

ifdef USE_HLE
# Delegate building the host genhle tool to its own sub-makefile.  FORCE
# makes us invoke it every time (so genhle gets rebuilt when its sources
# change) but the sub-make itself is a no-op when the binary is current —
# we only pay the cost of running make, not of re-linking.
FORCE:
genhle: FORCE
	@$(MAKE) -f Makefile.genhle

HLE_STAMP = $(BUILD_DIR)/.hle-stamp

# Single invocation of genhle produces ALL HLE files.  The stamp file solves
# the "one recipe, many outputs" make-parallelism hazard: every generated
# file depends on the stamp, but the recipe runs exactly once.
# `genhle` is an order-only prerequisite (after `|`) so that the sub-make's
# always-run pattern doesn't force us to regenerate HLE on every build —
# we only regen when the BIOS/ROM, m68kops.c, or the HLE_PCS list changes.
$(HLE_STAMP): $(MVS_STAMP) m68kops.c Makefile.mvs64 | genhle
	@echo "    [HLE] generating $(words $(HLE_PCS)) function(s) from $(ROMDIR)"
	./genhle $(ROMDIR)/p.rom $(ROMDIR)/p.bios@c00000 $(addprefix @,$(HLE_ENTRIES)) $(HLE_PCS) $(addprefix r,$(HLE_RUNS))
	@mkdir -p $(dir $@)
	@touch $@

$(HLE_ALL): $(HLE_STAMP)

# m68kcpu.c #includes hle_index.h when USE_HLE is set; this dependency tells
# make to generate the header before compiling that TU (before .d files exist).
$(BUILD_DIR)/m68kcpu.o: hle_index.h
endif

clean:
	rm -f $(obj)
	rm -f $(obj_makerom)
	rm -f $(asm:%.S=$(BUILD_DIR)/%.o)
	rm -f $(rsp:%.S=$(BUILD_DIR)/%.rsp)
	rm -f $(src:%.c=$(BUILD_DIR)/%.d) $(asm:%.S=$(BUILD_DIR)/%.d)
	rm -f mvs64-*.elf
	rm -f mvs64-*.dfs
	rm -f mvs64-*.z64
	rm -f hle_*.c hle_index.h
	rm -f $(BUILD_DIR)/.mvs-stamp $(BUILD_DIR)/.hle-stamp

-include $(src:%.c=$(BUILD_DIR)/%.d) $(asm:%.S=$(BUILD_DIR)/%.d) $(src_makerom:%.c=$(BUILD_DIR)/%.d)

.PHONY: clean test
